# ClaimShield AI Microservice Configuration

# 1. Google Gemini API Key (Multimodal Vision OCR & Fact-Check Reasoning)
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Google Fact Check Tools API Key (Claims search API)
# Enable API & get key from: https://console.cloud.google.com/apis/library/factchecktools.googleapis.com
GOOGLE_FACT_CHECK_API_KEY=

# 3. Live Web Search Provider (Serper.dev or Tavily.com for real-time live web facts)
SERPER_API_KEY=
TAVILY_API_KEY=

# 4. NewsAPI.org API Key (Mainstream Global News Wires)
NEWS_API_KEY=

PORT=8000
